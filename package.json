{
  "name": "opencode-codex-guardian",
  "version": "0.1.0",
  "private": true,
  "description": "Codex Guardian permission reviews for OpenCode V2",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihdogmus/opencode-codex-guardian.git"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --import tsx --test test/*.test.ts test/transports/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke-package.mjs",
    "verify:live": "node --import tsx scripts/verify-live.ts",
    "verify:code-mode": "node --import tsx scripts/verify-code-mode.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
